# All settings are optional: docker compose up --build works without a .env file.
# Copy this file to .env to override them. No keys or passwords are needed.

# Host port of the page and API; it is bound to 127.0.0.1 only.
PORT=8000

# auto uses the packaged local model; tfidf explicitly selects the lexical fallback.
ENCODER=auto

# Platform address used in material links; page paths come from the dump slugs.
PLATFORM_BASE_URL=https://kurs.alfabank.ru

# CATALOG_PATH, PERSONAS_PATH and EVENTS_PATH are read only from the shell environment
# of a run without Docker; writing them into .env has no effect.
